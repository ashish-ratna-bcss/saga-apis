# Copy to .env and adjust. Every setting has a working free-only default;
# nothing here requires payment or an API key.
#
# ============================================================
# LOCAL DEFAULT (no Docker) -- the settings that matter to get
# `./scripts/start_local.sh` (or `python -m app.main`) running.
# ============================================================

# SQLite, zero setup -- the default local/dev runtime. Worker runs
# in-process inside the API (see app/main.py's lifespan); no separate
# worker process needed in this mode.
OSINT_DATABASE_URL=sqlite:///./osint.db

# Native (no-Docker) SearxNG -- see README "Local Development" or
# scripts/setup_searxng.sh / start_searxng.sh. Without this, public_web (and
# GET/POST /api/v1/search) report "unavailable" instead of faking results.
OSINT_SEARXNG_URL=http://127.0.0.1:8890

# Engine subset actually verified to return results when self-hosted (see
# scripts/verify_searxng_engines.py) -- empty string lets SearxNG use its
# own full configured engine set instead.
OSINT_SEARXNG_ENGINES=google,bing,brave,wikipedia

# Host/port for `python -m app.main` (uvicorn's own --host/--port flags
# take precedence if you invoke uvicorn directly instead).
OSINT_HOST=127.0.0.1
OSINT_PORT=8000

# In-process worker pool size (SQLite mode only -- see app/orchestrator.py).
OSINT_WORKER_CONCURRENCY=4

# ============================================================
# GENERAL (same defaults in every mode)
# ============================================================

# Per-adapter HTTP request timeout, in seconds.
OSINT_ADAPTER_TIMEOUT_SECONDS=45

# maigret's bundled site database has 3000+ entries; capped to the top-ranked
# N by default to keep a single investigation's runtime bounded.
OSINT_MAIGRET_TOP_SITES=300

# Automatic pivot engine safety controls -- see README "Extraction + pivoting".
OSINT_PIVOT_ENABLED=true
OSINT_MAX_PIVOT_DEPTH=2
OSINT_MAX_TOTAL_PIVOTS_PER_INVESTIGATION=15
OSINT_MAX_PIVOTS_PER_ENTITY=5
OSINT_PIVOT_CONFIDENCE_THRESHOLD=0.5
OSINT_MAX_INVESTIGATION_RUNTIME_SECONDS=600

# Caps how many investigations can be queued/running at once across all clients.
OSINT_MAX_CONCURRENT_INVESTIGATIONS=10

# Per-process cap on concurrent calls to the same source adapter.
OSINT_SOURCE_MAX_CONCURRENCY=3

# Document (PDF/HTML/TXT) mining -- deep mode only, see README "Document mining".
OSINT_DOCUMENT_MINING_ENABLED=true
OSINT_MAX_DOCUMENTS_PER_INVESTIGATION=10
OSINT_DOCUMENT_FETCH_TIMEOUT_SECONDS=15
OSINT_MAX_DOCUMENT_BYTES=10485760

# Retry policy for transient adapter failures -- see README "Service reliability".
# Never applies to permanently-blocked sources (MCA, eCourts) or unexpected bugs.
OSINT_ADAPTER_MAX_RETRIES=2
OSINT_ADAPTER_RETRY_BACKOFF_SECONDS=0.5

# Data retention -- both unset (keep forever) by default. Run
# `python -m app.retention` (cron/systemd timer) to apply once set.
OSINT_INVESTIGATION_RETENTION_DAYS=
OSINT_AUDIT_LOG_RETENTION_DAYS=

# ============================================================
# POSTGRES / DOCKER MODE ONLY -- ignored entirely on SQLite.
# Only relevant if you set OSINT_DATABASE_URL to a postgresql+psycopg://
# URL and run `docker compose up` (or `python -m app.worker_main` as a
# separate process) -- see README "Running in production".
# ============================================================

# OSINT_DATABASE_URL=postgresql+psycopg://osint:osint_dev_pw@localhost:5432/osint

# Connection pool.
OSINT_DB_POOL_SIZE=5
OSINT_DB_MAX_OVERFLOW=10
OSINT_DB_POOL_TIMEOUT=30
OSINT_DB_POOL_RECYCLE_SECONDS=1800

# How long a worker's claim on an investigation is valid before another
# worker's idle-poll cycle treats it as crashed and reclaims it.
OSINT_INVESTIGATION_LEASE_SECONDS=120
