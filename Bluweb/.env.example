# PostgreSQL -- REQUIRED. Points at your existing external Postgres server.
# Schema contract: docs/unified_schema.sql (apply manually once; Alembic is NOT used).
# PostgreSQL is NOT started via Docker.
# Example: postgresql+asyncpg://user:password@db.example.com:5432/webintel
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>

# Crawler / preflight tuning
PREFLIGHT_MAX_SAMPLE_PAGES=15
PREFLIGHT_HTTP_TIMEOUT_SECONDS=10
PREFLIGHT_BROWSER_TIMEOUT_SECONDS=20
PREFLIGHT_REPORT_TTL_HOURS=24
CRAWLER_USER_AGENT=WebIntelBot/0.1 (+https://example.com/bot)

# Security
BLOCK_PRIVATE_NETWORKS=true
ALLOWED_SCHEMES=http,https

# Object storage (raw artifacts)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=webintel
MINIO_SECRET_KEY=webintel12345
MINIO_BUCKET=web-intel-raw
MINIO_SECURE=false

# Instant crawl
CRAWL_DEFAULT_MAX_PAGES=100
CRAWL_DEFAULT_MAX_DEPTH=3
CRAWL_DEFAULT_CONCURRENCY=5
CRAWL_MAX_RESPONSE_BYTES=20000000

# Monitoring / scheduler
MONITORING_REMOVAL_FAILURE_THRESHOLD=3
SCHEDULER_POLL_INTERVAL_SECONDS=30

# Hugging Face (GLiNER primary NER — first download only; then cached)
# Create a read token at https://huggingface.co/settings/tokens
# If you previously ran `huggingface-cli login` with an expired token,
# remove ~/.cache/huggingface/token or this value will still 401.
HF_TOKEN=your_huggingface_token_here
