# Optional local overrides for the stateless Bluweb API.
# No DATABASE_URL — this service does not store scraped content.
# Callers receive JSON from /api/v1/scrape and /api/v1/preflight and persist themselves.

# Crawler / preflight tuning
PREFLIGHT_MAX_SAMPLE_PAGES=15
PREFLIGHT_HTTP_TIMEOUT_SECONDS=10
PREFLIGHT_BROWSER_TIMEOUT_SECONDS=20
PREFLIGHT_REPORT_TTL_HOURS=24
CRAWLER_USER_AGENT=WebIntelBot/0.1 (+https://example.com/bot)

# Security
BLOCK_PRIVATE_NETWORKS=true
ALLOWED_SCHEMES=http,https

# Instant scrape budgets
CRAWL_MAX_RESPONSE_BYTES=20000000
CRAWL_MAX_CONCURRENT_BROWSER_GLOBAL=8

# Hugging Face (optional — GLiNER first download only; then cached)
# HF_TOKEN=your_huggingface_token_here
