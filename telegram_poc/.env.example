# --- Telegram MTProto credentials (https://my.telegram.org/apps) -----------
# Never commit real values. Loaded at runtime only, never logged.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram_service.session

# Phone number is only needed the first time you drive the non-interactive
# login flow (POST /api/telegram/auth/send-code) - it is never hard-coded
# into source and never logged. Safe to leave blank if a session already
# exists.
TELEGRAM_PHONE=

# --- Database ----------------------------------------------------------------
# SQLite by default. Swappable for Postgres later without touching business
# logic (e.g. postgresql+asyncpg://user:pass@host/db) since access only ever
# goes through the repository layer.
DATABASE_URL=sqlite+aiosqlite:///./data/telegram_service.db

# --- Collection / media policy ------------------------------------------------
MEDIA_DOWNLOAD_ENABLED=false
MEDIA_STORAGE_PATH=./data/media
MAXIMUM_MEDIA_SIZE_BYTES=20971520
ALLOWED_MEDIA_TYPES=photo,document,video,audio,voice

RAW_EVIDENCE_STORAGE_PATH=./data/raw_messages
COLLECTION_BATCH_LIMIT=200

# --- Bot-start workflow (POST /api/telegram/bots/{id}/start) -----------------
# How long to wait for a bot's reply to /start, and how often to poll for it.
BOT_START_TIMEOUT_SECONDS=15
BOT_START_POLL_INTERVAL_SECONDS=1

# --- Scheduler intervals ------------------------------------------------------
ACCESS_RECONCILIATION_INTERVAL_HOURS=12
COLLECTION_INTERVAL_MINUTES=5
CONNECTION_HEALTH_INTERVAL_MINUTES=5
NOTIFICATION_PROCESSING_INTERVAL_MINUTES=1

# --- App -----------------------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
